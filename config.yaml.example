# Doc Reader 配置示例
# 复制此文件为 config.yaml 并根据需要修改

# 文档目录（支持多个）
directories:
  - path: ~/Documents/markdown
    name: 示例文档
  # 可以添加更多目录
  # - path: ~/Documents/notes
  #   name: 笔记

# 服务器配置
server:
  host: 127.0.0.1    # 监听地址，0.0.0.0 表示所有网卡
  port: 5000         # 监听端口
  debug: false       # 调试模式

# 认证配置
auth:
  enabled: false     # 默认关闭；如需启用，请先修改下面的密钥和账户
  jwt_secret: "your-secret-key-change-this-in-production"  # JWT 密钥，请修改！
  token_expiration_hours: 720  # Token 过期时间（小时）
  users:
    - username: change-me
      password: change-me-too
      hashed: false  # true 表示 password 字段存储的是哈希值

# 功能开关
features:
  search: true       # 搜索功能
  dark_mode: true    # 暗色模式

# 文章 AI 配图配置
illustrator:
  enabled: true
  text_provider: openai-compatible      # openai-compatible / mock
  text_model: gpt-4.1-mini
  text_base_url: https://api.openai.com/v1
  text_api_key_env: OPENAI_API_KEY
  image_provider: openai-compatible     # openai-compatible / custom-command / mock
  image_model: gpt-image-1
  image_base_url: https://api.openai.com/v1
  image_api_key_env: OPENAI_API_KEY
  image_size: 1536x1024
  image_quality: auto
  custom_image_command: ""              # 使用 custom-command 时读取 PROMPT_FILE 并写入 OUTPUT_FILE
  default_preset: hand-drawn-edu
  default_density: balanced             # minimal / balanced / per-section / rich
  default_output_dir: imgs-subdir        # imgs-subdir / same-dir / illustrations-subdir / independent
  batch_size: 2
  timeout_seconds: 120
  retry_count: 1
